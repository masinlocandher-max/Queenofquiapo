# Queen of Quiapo Worker configuration. Names only: never commit real values.
REVIEWER_EMAIL=            # verified sign-in email of the organizer (the only organizer account)
QOQ_SUPABASE_URL=          # https://<project>.supabase.co
QOQ_PUBLISHABLE_KEY=       # Supabase publishable (anon) key
QOQ_SERVER_SECRET=         # 32+ random characters; its SHA-256 goes in qoq_private.settings.secret_hash
QOQ_RATE_SALT=             # random string for request throttling
QOQ_INTAKE_BACKEND=        # leave empty for Supabase; "legacy" keeps applications on D1/R2 (no status tracking)
QOQ_VOTE_DOMAIN_READY=     # "yes" once vote.queenofquiapo.com resolves to this Worker
QOQ_CSP=                   # "enforce" after sign-in is verified under the policy; otherwise report-only

# Payments. Leave every line empty in production until the activation gate in docs/PAYMENTS.md is complete.
QOQ_PAYMENTS_ENABLED=      # "yes" authorizes checkout for this deployment. Default: off.
QOQ_PAYMENT_PROVIDER=      # adapter name in server/payments.mjs
QOQ_PAYMENT_WEBHOOK_SECRET=# provider webhook signing secret, 32+ characters
QOQ_ALLOW_SANDBOX_PAYMENTS=# "yes" only on the preview hostname for rehearsals; ignored on production hostnames
